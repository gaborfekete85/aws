# Copy to .env.local for `bun run dev` against a deployed environment.
# CI writes these from `terraform output` before building (see .github/workflows/deploy.yml).
VITE_API_URL=https://xxxx.execute-api.eu-central-1.amazonaws.com
VITE_COGNITO_USER_POOL_ID=eu-central-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=meeton-dev-xxxxxx.auth.eu-central-1.amazoncognito.com
VITE_WEB_URL=http://localhost:5173
# "fake" = in-memory auth for offline development and the Playwright smoke test
VITE_AUTH_MODE=amplify
